+def image_setting(name: str, default: int, low: int, high: int) -> int:
+    value = os.environ.get(name, "").strip()
+    if not value:
+        return default
+    if not value.isdecimal() or not low <= int(value) <= high:
+        raise ValueError(f"{name}: {low:,} to {high:,}, not {value!r}")
+    return int(value)
 
 
