+                "d_amq": 0, "d_amp": 0, "qam": 0.0, "pamq": 0.0,
+                "pos_n": [0] * 16, "pos_acc": [0] * 16,
+                "rounds": 0, "spec_rounds": 0, "spec_rows": 0,
