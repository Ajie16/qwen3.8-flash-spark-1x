+    def _spec_verify_job(
+        self,
+        job,
+        j: int,
+        job_logits: torch.Tensor,
+        draft_tokens: torch.Tensor,
+        batch_states,
+        results: list,
+        rewound_jobs: set,
+        completed_jobs: list,
+        requeuing_jobs: list,
